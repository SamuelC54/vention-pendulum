{
  "name": "vention-pendulum-api",
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsnd --respawn --transpile-only --exit-child --poll src/index.ts",
    "start-proxy-only": "docker-compose up envoy --no-deps",
    "compose-up": "docker-compose up",
    "compose-down": "docker-compose down",
    "test": "tap --node-arg=--require=ts-node/register",
    "proto:gen": "rimraf ./src/_generated/proto && proto-loader-gen-types --grpcLib=@grpc/grpc-js --json=true --outDir=src/_generated/proto ./protobuf/pendulum.proto"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.3",
    "@grpc/proto-loader": "^0.7.15",
    "dotenv": "^16.4.5",
    "fastify": "^3.27.2",
    "fastify-cors": "^6.0.3",
    "fastify-swagger": "^4.15.0",
    "mqtt": "^5.10.1",
    "node-fetch": "^2.7.0",
    "tap": "^16.0.0"
  },
  "devDependencies": {
    "@types/node-fetch": "^2.6.11",
    "@types/tap": "^15.0.6",
    "cross-env": "^7.0.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.7.0",
    "ts-node-dev": "^1.1.8",
    "typescript": "^4.5.5"
  }
}
